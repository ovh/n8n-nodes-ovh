{
	"name": "@ovhcloud/n8n-nodes-ovh",
	"version": "0.1.0",
	"description": "Official n8n nodes for OVH API",
	"license": "MIT",
	"homepage": "https://github.com/ovh/n8n-nodes-ovh#readme",
	"bugs": {
		"url": "https://github.com/ovh/n8n-nodes-ovh/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"ovh",
		"ovhcloud"
	],
	"author": {
		"name": "Atef ZAAFOURI",
		"email": "atef.zaafouri@ovhcloud.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ovh/n8n-nodes-ovh.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.svg"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OvhApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Ovh/Ovh.node.js",
			"dist/nodes/OvhTrigger/OvhTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.38.6",
		"@types/node": "^24.0.0",
		"eslint": "^9.32.0",
		"prettier": "3.9.4",
		"release-it": "^20.2.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
